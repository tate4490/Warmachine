        },
        {
            "guidStr": "24fc5f90-c1f7-45d7-bb0c-f113586adb12",
            "name": [
                "Name",
                "",
                "",
                "",
                ""
            ],
            "isLive": false,
            "metadata": "",
            "deleted": false,
