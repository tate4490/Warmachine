        },
        {
            "guidStr": "3c2fdefb-23ca-450e-acc9-7deae61e9314",
            "name": [
                "Name",
                "",
                "",
                "",
                ""
            ],
            "isLive": false,
            "metadata": "",
            "deleted": false,
            "type": "Body",
            "topMarginOverride": -1,
            "bottomMarginOverride": -1,
            "leftMarginOverride": -1,
            "rightMarginOverride": -1,
            "title": [
                "",
                "",
                "",
                "",
                "",
                ""
            ],
            "body": [
                "\"Sergeant Leeds,\" she said, motioning to one of the legionnaires seeing to Onus, \"find Kommander Savaryn. Bring him here. Now.\"",
                "",
                "",
                "",
                "",
                ""
            ],
            "colorHex": "",
            "textColorHex": "",
            "mediaPath": "",
            "widthPerc": 100,
            "mediaWidth": 0,
